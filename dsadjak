import tkinter as tk

root = tk.Tk()
root.withdraw()

keys = []
oldkeys = keys.copy()

root.bind("<KeyPress>", lambda event: keys.append(event.keysym))

def update():
    global keys, oldkeys
    
    if oldkeys == keys:
        if keys:
            print("[",end="")
            for key in keys:
                print(key,end="")
            print("]")
        
        keys = []
        
    oldkeys = keys.copy()
   
    time = 250
    root.after(time,update)

update()
root.mainloop()
